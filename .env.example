# ECA-PQFA local configuration
ECA_PQFA_APP_NAME=ECA-PQFA Research Engine
ECA_PQFA_HOST=127.0.0.1
ECA_PQFA_PORT=8000
ECA_PQFA_DB_PATH=./data/eca_pqfa.sqlite3
